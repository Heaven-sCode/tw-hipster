import { Injectable } from '@angular/core';
import { FormControl, FormGroup, Validators } from '@angular/forms';
import dayjs from 'dayjs/esm';
import { I<%= entity.name %>, New<%= entity.name %> } from '../<%= toKebabCase(entity.name) %>.model';

<%
const dateFields = entity.fields.filter(f => ['LocalDate', 'Instant', 'ZonedDateTime'].includes(f.fieldType));
%>

type <%= entity.name %>FormGroupInput = I<%= entity.name %> | Partial<New<%= entity.name %>>;
type <%= entity.name %>FormRawValue = Omit<I<%= entity.name %>, <%- dateFields.length ? dateFields.map(f => `'${f.fieldName}'`).join(' | ') : 'never' %>> & {
  <% dateFields.forEach(field => { %>
  <%= field.fieldName %>?: Date | null;
  <% }); %>
};
export type <%= entity.name %>FormGroup = FormGroup<{
  id: FormControl<I<%= entity.name %>['id'] | New<%= entity.name %>['id']>;
  <% entity.fields.forEach(field => { %>
  <%= field.fieldName %>: FormControl<<% if (['LocalDate', 'Instant', 'ZonedDateTime'].includes(field.fieldType)) { %>Date | null<% } else { %>I<%= entity.name %>['<%= field.fieldName %>']<% } %>>;
  <% }); %>
}>;

@Injectable({ providedIn: 'root' })
export class <%= entity.name %>FormService {
  create<%= entity.name %>FormGroup(entity: <%= entity.name %>FormGroupInput = { id: null }): <%= entity.name %>FormGroup {
    const form = new FormGroup({
      id: new FormControl(
        { value: entity.id, disabled: true },
        { nonNullable: true, validators: [Validators.required] }
      ),
      <% entity.fields.forEach(field => { %>
      <%= field.fieldName %>: new FormControl(<% if (['LocalDate', 'Instant', 'ZonedDateTime'].includes(field.fieldType)) { %>this.convertDateForForm(entity.<%= field.fieldName %>)<% } else { %>entity.<%= field.fieldName %><% } %><% if (field.fieldValidateRules.includes('required')) { %>, Validators.required<% } %>),
      <% }); %>
    });
    return form;
  }

  get<%= entity.name %>(form: <%= entity.name %>FormGroup): I<%= entity.name %> | New<%= entity.name %> {
    const rawValue = form.getRawValue() as <%= entity.name %>FormRawValue;
    return {
      ...rawValue,
      <% dateFields.forEach(field => { %>
      <%= field.fieldName %>: rawValue.<%= field.fieldName %> ? dayjs(rawValue.<%= field.fieldName %>) : null,
      <% }); %>
    } as I<%= entity.name %> | New<%= entity.name %>;
  }

  resetForm(form: <%= entity.name %>FormGroup, entity: <%= entity.name %>FormGroupInput): void {
    form.reset({
      ...entity,
      <% dateFields.forEach(field => { %>
      <%= field.fieldName %>: this.convertDateForForm(entity.<%= field.fieldName %>),
      <% }); %>
    } as any);
    form.controls.id.setValue(entity.id);
  }

  private convertDateForForm(value: unknown): Date | null {
    if (!value) {
      return null;
    }
    if (value instanceof Date) {
      return value;
    }
    if (dayjs.isDayjs(value)) {
      return value.toDate();
    }
    const parsed = new Date(value as string);
    return Number.isNaN(parsed.getTime()) ? null : parsed;
  }
}
