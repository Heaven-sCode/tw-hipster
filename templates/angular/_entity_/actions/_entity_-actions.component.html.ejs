<div class="mt-6 grid w-full grid-cols-2 gap-3 md:ml-4 md:mt-0 md:flex md:w-auto md:shrink-0 md:items-center">
  
  <mat-form-field appearance="outline" subscriptSizing="dynamic" class="w-full md:w-40">
    <mat-select [ngModel]="searchBy" (ngModelChange)="onSearchByChange($event)">
        <mat-option *ngFor="let col of searchableColumns" [value]="col">
          {{ getColumnLabel(col) }}
        </mat-option>
      </mat-select>
    </mat-form-field>

<mat-form-field appearance="outline" subscriptSizing="dynamic" class="w-full md:w-64">
  <mat-icon matPrefix svgIcon="search" class="text-neutral-500 mr-2"></mat-icon>
  <input matInput placeholder="Search…" [ngModel]="searchTerm" (ngModelChange)="onSearchTermChange($event)" />
  <button mat-icon-button matSuffix type="button" (click)="onSearchTermChange('')" *ngIf="searchTerm" class="h-8 w-8 min-w-0 p-0 flex items-center justify-center">
    <mat-icon svgIcon="x" class="text-neutral-500"></mat-icon>
  </button>
</mat-form-field>

  <div class="search-bar col-span-2 flex items-center justify-start gap-3">
    
    <button mat-stroked-button type="button" [matMenuTriggerFor]="columnMenu" class="w-12 h-10 min-w-0 p-0">
      <span class="flex items-center justify-center">
        <mat-icon svgIcon="menu" class="m-0"></mat-icon>
      </span>
    </button>
    <button mat-stroked-button type="button" (click)="toggleViewMode()" [matTooltip]="viewMode === 'table' ? 'Switch to Card View' : 'Switch to Table View'" class="w-12 h-10 min-w-0 p-0">
      <span class="flex items-center justify-center">
        @if (viewMode === 'table') {
          <mat-icon svgIcon="credit-card" class="m-0"></mat-icon>
        } @else {
          <mat-icon svgIcon="table" class="m-0"></mat-icon>
        }
      </span>
    </button>
<button *ngIf="filterFieldsLength" mat-stroked-button type="button" class="w-12 h-10 min-w-0 p-0" (click)="filterClick.emit()">
      <span class="flex items-center justify-center">
         <mat-icon svgIcon="funnel" class="m-0"></mat-icon>
      </span>
    </button>
    <button mat-flat-button color="primary" type="button" class="h-10" (click)="newClick.emit()">
      <span class="flex items-center justify-center">
        <mat-icon svgIcon="plus" class="m-0 mr-2"></mat-icon>
        <span>New</span>
      </span>
    </button>
  </div>
</div>
