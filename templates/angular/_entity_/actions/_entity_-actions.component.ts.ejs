import { Component, EventEmitter, Input, Output } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { MatButtonModule } from '@angular/material/button';
import { MatIconModule } from '@angular/material/icon';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import { MatSelectModule } from '@angular/material/select';
import { MatMenu, MatMenuModule } from '@angular/material/menu';
import { MatTooltipModule } from '@angular/material/tooltip';

@Component({
  selector: 'app-<%= toKebabCase(entity.name) %>-actions',
  templateUrl: './<%= toKebabCase(entity.name) %>-actions.component.html',
  host: {
    class: 'block w-full xl:w-auto',
  },
  standalone: true,
  imports: [
    CommonModule,
    FormsModule,
    MatButtonModule,
    MatIconModule,
    MatFormFieldModule,
    MatInputModule,
    MatSelectModule,
    MatMenuModule,
    MatTooltipModule
  ]
})
export class <%= entity.name %>ActionsComponent {
  @Input() searchableColumns: string[] = [];
  @Input() searchBy: string = '';
  @Input() searchTerm: string = '';
  @Input() viewMode: 'table' | 'card' = 'table';
  @Input() filterFieldsLength = 0;
  @Input() columnMenu!: MatMenu;
  @Input() allColumnPreferences: { key: string; label: string }[] = [];

  @Output() searchChange = new EventEmitter<{ searchBy: string; searchTerm: string }>();
  @Output() filterClick = new EventEmitter<void>();
  @Output() viewModeChange = new EventEmitter<'table' | 'card'>();
  @Output() newClick = new EventEmitter<void>();

  onSearchChange(): void {
    this.searchChange.emit({ searchBy: this.searchBy, searchTerm: this.searchTerm });
  }

  toggleViewMode(): void {
    const nextMode = this.viewMode === 'table' ? 'card' : 'table';
    this.viewModeChange.emit(nextMode);
  }

  getColumnLabel(key: string): string {
    const col = this.allColumnPreferences.find(item => item.key === key);
    return col ? col.label : key;
  }
}
