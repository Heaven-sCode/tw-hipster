  private exportData(filters: Record<string, string | number>): void {
    this.isExporting = true;
    const exportReq = {
      page: 0,
      size: this.totalItems > 0 ? this.totalItems : 1000,
      sort: this.getSortParameters(),
      ...filters,
    };

    this.<%= toCamelCase(entity.name) %>Service.query(exportReq).pipe(
      tap(response => {
        const rows = response.body ?? [];
        this.downloadCsv(rows);
      }),
      catchError(() => of(null)),
      finalize(() => {
        this.isExporting = false;
      })
    ).subscribe();
  }

  private restoreColumnPreferences(): void {
    const defaultColumns = this.allColumnPreferences.map(item => item.key);
    const saved = this.readSavedColumnPreferences();
    if (!saved.length) {
      this.displayedColumns = defaultColumns;
      return;
    }

    const savedColumnSet = new Set(saved);
    this.displayedColumns = this.allColumnPreferences
      .filter(item => item.alwaysVisible || savedColumnSet.has(item.key))
      .map(item => item.key);
  }

  private persistColumnPreferences(): void {
    if (typeof localStorage === 'undefined') {
      return;
    }
    const optionalColumns = this.allColumnPreferences
      .filter(item => !item.alwaysVisible && this.displayedColumns.includes(item.key))
      .map(item => item.key);
    localStorage.setItem(this.columnPreferenceStorageKey, JSON.stringify(optionalColumns));
  }

  private readSavedColumnPreferences(): string[] {
    if (typeof localStorage === 'undefined') {
      return [];
    }
    try {
      const raw = localStorage.getItem(this.columnPreferenceStorageKey);
      if (!raw) {
        return [];
      }
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed.filter(value => typeof value === 'string') : [];
    } catch {
      return [];
    }
  }

  private downloadCsv(rows: I<%= entity.name %>[]): void {
    const exportableColumns = this.allColumnPreferences.filter(
      item =>
        this.displayedColumns.includes(item.key) &&
        !item.key.startsWith('actions') &&
        item.key !== 'state'
    );
    const header = exportableColumns.map(item => item.label);
    const dataRows = rows.map(row =>
      exportableColumns.map(column => this.toCsvValue(this.resolveColumnValue(row, column.key)))
    );
    const csvContent = [header, ...dataRows]
      .map(columns => columns.map(value => this.escapeCsv(value)).join(','))
      .join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = '<%= toKebabCase(entity.name) %>-' + dayjs().format('YYYY-MM-DD-HHmmss') + '.csv';
    link.style.display = 'none';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  }

  private resolveColumnValue(row: I<%= entity.name %>, columnKey: string): string {
    const value = (row as Record<string, unknown>)[columnKey];
    if (value === null || value === undefined) {
      return '';
    }
    if (dayjs.isDayjs(value)) {
      return value.toISOString();
    }
    if (value instanceof Date) {
      return value.toISOString();
    }
    if (typeof value === 'object') {
      return JSON.stringify(value);
    }
    return String(value);
  }

  handleSearchChanged(event: { searchBy: string; searchTerm: string }): void {
    this.searchBy = event.searchBy;
    this.searchTerm = event.searchTerm;

    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(this.storageKeySearchTerm, this.searchTerm);
      localStorage.setItem(this.storageKeySearchBy, this.searchBy);
    }

    // Clear previous search filters
    this.searchableColumns.forEach(col => {
      delete this.activeFilters[`${col}.contains`];
    });

    if (this.searchTerm && this.searchBy) {
      this.activeFilters[`${this.searchBy}.contains`] = this.searchTerm;
    }

    if (this.paginator) {
      this.paginator.firstPage();
    }
    this.refreshTrigger.next();
    this.loadData();
  }

  togglePin(element: I<%= entity.name %>): void {
    if (element.id === undefined) return;
    if (this.pinnedIds.has(element.id)) {
      this.pinnedIds.delete(element.id);
    } else {
      this.pinnedIds.add(element.id);
    }
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(this.storageKeyPinned, JSON.stringify(Array.from(this.pinnedIds)));
    }
    this.dataSource.data = this.sortRowsForDisplay([...this.dataSource.data]);
  }

  isPinned(id?: number): boolean {
    return id !== undefined && this.pinnedIds.has(id);
  }

  setFlagMenuRow(element: I<%= entity.name %>): void {
    this.activeFlagRowId = element.id ?? null;
  }

  setFlagColor(colorKey: string | null): void {
    if (this.activeFlagRowId === null) {
      return;
    }

    if (colorKey) {
      this.rowFlagColors[this.activeFlagRowId] = colorKey;
    } else {
      delete this.rowFlagColors[this.activeFlagRowId];
    }

    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(this.storageKeyFlags, JSON.stringify(this.rowFlagColors));
    }
    this.activeFlagRowId = null;
  }

  getFlagColor(id?: number): string | null {
    if (id === undefined) {
      return null;
    }
    return this.rowFlagColors[id] ?? null;
  }

  getFlagClass(id?: number): string {
    const colorKey = this.getFlagColor(id);
    if (!colorKey) {
      return 'text-neutral-300';
    }
    return this.rowFlagOptions.find(option => option.key === colorKey)?.iconClass ?? 'text-neutral-300';
  }

  <% if (entity.fields.some(f => f.fieldName === 'isActive')) { %>
  toggleActive(element: I<%= entity.name %>): void {
    if (element.id === undefined) return;
    
    const newActiveState = !element.isActive;
    const actionLabel = newActiveState ? 'Activate' : 'Deactivate';
    
    this.confirmationService.open({
      title: `${actionLabel} <%= entity.name %>`,
      message: `Are you sure you want to ${newActiveState ? 'activate' : 'deactivate'} this <%= toCamelCase(entity.name) %>?`,
      icon: {
        show: true,
        name: 'heroicons_outline:information-circle',
        color: newActiveState ? 'success' : 'warn'
      },
      actions: {
        confirm: {
          label: actionLabel,
          color: newActiveState ? 'primary' : 'warn'
        },
        cancel: {
          label: 'Cancel'
        }
      },
      dismissible: true
    }).afterClosed().subscribe(result => {
      if (result === 'confirmed') {
        const updated = { ...element, isActive: newActiveState };
        this.<%= toCamelCase(entity.name) %>Service.update(updated).subscribe(() => {
          this.refreshTrigger.next();
          this.loadData();
        });
      }
    });
  }
  <% } %>

  getRowClass(element: I<%= entity.name %>): string {
    let classes = '';
    const colorKey = this.getFlagColor(element.id);
    if (colorKey) {
      classes = 'has-flag ';
      switch (colorKey) {
        case 'slate':
          classes += 'bg-slate-50/80 dark:bg-slate-900/20 hover:bg-slate-100/80 dark:hover:bg-slate-950/30';
          break;
        case 'blue':
          classes += 'bg-blue-50/80 dark:bg-blue-900/20 hover:bg-blue-100/80 dark:hover:bg-blue-950/30';
          break;
        case 'emerald':
          classes += 'bg-emerald-50/80 dark:bg-emerald-900/20 hover:bg-emerald-100/80 dark:hover:bg-emerald-950/30';
          break;
        case 'amber':
          classes += 'bg-amber-50/80 dark:bg-amber-900/20 hover:bg-amber-100/80 dark:hover:bg-amber-950/30';
          break;
        case 'rose':
          classes += 'bg-rose-50/80 dark:bg-rose-900/20 hover:bg-rose-100/80 dark:hover:bg-rose-950/30';
          break;
        case 'violet':
          classes += 'bg-violet-50/80 dark:bg-violet-900/20 hover:bg-violet-100/80 dark:hover:bg-violet-950/30';
          break;
      }
    }
    <% if (entity.fields.some(f => f.fieldName === 'isActive')) { %>
    if (element.isActive === false) {
      classes += ' opacity-50';
    }
    <% } %>
    return classes;
  }

  getStickyClass(element: I<%= entity.name %>): string {
    const colorKey = this.getFlagColor(element.id);
    if (!colorKey) {
      return 'sticky-actions-default';
    }
    switch (colorKey) {
      case 'slate':
        return '!bg-slate-50/90 dark:!bg-slate-950/40 group-hover:!bg-slate-100/90 dark:group-hover:!bg-slate-900/50';
      case 'blue':
        return '!bg-blue-50/90 dark:!bg-blue-950/40 group-hover:!bg-blue-100/90 dark:group-hover:!bg-blue-900/50';
      case 'emerald':
        return '!bg-emerald-50/90 dark:!bg-emerald-950/40 group-hover:!bg-emerald-100/90 dark:group-hover:!bg-emerald-900/50';
      case 'amber':
        return '!bg-amber-50/90 dark:!bg-amber-950/40 group-hover:!bg-amber-100/90 dark:group-hover:!bg-amber-900/50';
      case 'rose':
        return '!bg-rose-50/90 dark:!bg-rose-950/40 group-hover:!bg-rose-100/90 dark:group-hover:!bg-rose-900/50';
      case 'violet':
        return '!bg-violet-50/90 dark:!bg-violet-950/40 group-hover:!bg-violet-100/90 dark:group-hover:!bg-violet-900/50';
      default:
        return 'sticky-actions-default';
    }
  }

  getColumnLabel(key: string): string {
    const col = this.allColumnPreferences.find(item => item.key === key);
    return col ? col.label : key;
  }

  viewDetails(id: number): void {
    this.router.navigate(['/admin/<%= toKebabCase(entity.name) %>', id, 'view']);
  }

  highlightText(text: any, query: string): string {
    if (!query || text === null || text === undefined) return text ? String(text) : '';
    const textStr = String(text);
    const regex = new RegExp(`(${this.escapeRegExp(query)})`, 'gi');
    return textStr.replace(regex, '<span class="bg-yellow-100 font-semibold text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400">$1</span>');
  }

  private escapeRegExp(string: string): string {
    return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  loadSearchState(): void {
    if (typeof localStorage === 'undefined') {
      return;
    }
    this.searchTerm = localStorage.getItem(this.storageKeySearchTerm) ?? '';
    this.searchBy = localStorage.getItem(this.storageKeySearchBy) ?? (this.searchableColumns[0] ?? '');
    
    try {
      const pinned = localStorage.getItem(this.storageKeyPinned);
      if (pinned) {
        this.pinnedIds = new Set<number>(JSON.parse(pinned));
      }
    } catch {
      this.pinnedIds = new Set<number>();
    }

    try {
      const flags = localStorage.getItem(this.storageKeyFlags);
      if (flags) {
        const parsed = JSON.parse(flags);
        this.rowFlagColors = parsed && typeof parsed === 'object' ? parsed : {};
      }
    } catch {
      this.rowFlagColors = {};
    }

    if (this.searchTerm && this.searchBy) {
      this.activeFilters[`${this.searchBy}.contains`] = this.searchTerm;
    }
  }

  private sortRowsForDisplay(rows: I<%= entity.name %>[]): I<%= entity.name %>[] {
    return [...rows].sort((left, right) => {
      const leftPinned = this.isPinned(left.id);
      const rightPinned = this.isPinned(right.id);
      if (leftPinned === rightPinned) {
        return 0;
      }
      return leftPinned ? -1 : 1;
    });
  }

  private toCsvValue(value: string): string {
    return value ?? '';
  }

  private escapeCsv(value: string): string {
    const normalizedValue = value.replace(/"/g, '""');
    return `"${normalizedValue}"`;
  }
}
