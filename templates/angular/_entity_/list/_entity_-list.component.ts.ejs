  ngOnInit(): void {
    if (typeof window !== 'undefined' && window.innerWidth < 640) {
      this.viewMode = 'card';
    }
    this.restoreColumnPreferences();
    this.loadSearchState();
    if (typeof localStorage !== 'undefined') {
      const savedPageSize = localStorage.getItem(this.storageKeyPageSize);
      if (savedPageSize) {
        this.itemsPerPage = Number(savedPageSize);
      }
    }
    if (this.dialogData?.parentFilters) {
      this.baseParentFilters = { ...this.dialogData.parentFilters };
    }
  }

  @HostListener('window:resize')
  onWindowResize(): void {
    this.onTableScroll();
  }

  onTableScroll(): void {
    if (!this.tableWrapper) return;
    const target = this.tableWrapper.nativeElement;
    const maxScroll = target.scrollWidth - target.clientWidth;
    const nextState = maxScroll > 0 && target.scrollLeft < maxScroll - 2;
    if (this.isActionsShadowVisible !== nextState) {
      this.isActionsShadowVisible = nextState;
    setTimeout(() => this.cdr.detectChanges());
    }
  }

  ngAfterViewInit(): void {
    setTimeout(() => {
      const triggers$ = merge(this.paginator.page, this.refreshTrigger).pipe(startWith({}));

      if (this.dialogData?.parentFilters) {
        triggers$.subscribe(() => this.loadData());
      } else {
        this.route.params
          .pipe(
            tap(params => {
              this.baseParentFilters = {};
              const parentIdKey = Object.keys(params)[0];
              if (parentIdKey) {
                const parentModelName = parentIdKey.replace('Id', '');
                this.baseParentFilters[`${parentModelName}Id.equals`] = params[parentIdKey];
              }
            }),
            switchMap(() => triggers$)
          )
          .subscribe(() => this.loadData());
      }
    }, 0);
  }

  loadData(): void {
    if (!this.paginator) {
      return;
    }

    if (typeof localStorage !== 'undefined' && this.paginator.pageSize !== this.itemsPerPage) {
      this.itemsPerPage = this.paginator.pageSize;
      localStorage.setItem(this.storageKeyPageSize, String(this.itemsPerPage));
    }

    this.isLoading = true;
    const req = {
      page: this.paginator.pageIndex,
      size: this.paginator.pageSize,
      sort: this.getSortParameters(),
      ...this.baseParentFilters,
      ...this.activeFilters,
    };

    this.<%= toCamelCase(entity.name) %>Service.query(req).pipe(
      tap(res => {
        this.isLoading = false;
        this.totalItems = Number(res.headers.get('X-Total-Count') ?? 0);
        this.dataSource.data = this.sortRowsForDisplay(res.body ?? []);
        this.cdr.detectChanges();
        setTimeout(() => this.onTableScroll(), 0);
      }),
      catchError(() => {
        this.isLoading = false;
        this.cdr.detectChanges();
        return of(null);
      })
    ).subscribe();
  }

  getSortParameters(): string[] {
    if (!this.sort || !this.sort.active || this.sort.direction === '') {
      return ['id,asc'];
    }
    return [`${this.sort.active},${this.sort.direction}`];
  }

  isColumnVisible(columnKey: string): boolean {
    return this.displayedColumns.includes(columnKey);
  }

  toggleColumn(columnKey: string): void {
    const column = this.allColumnPreferences.find(item => item.key === columnKey);
    if (!column || column.alwaysVisible) {
      return;
    }

    if (this.isColumnVisible(columnKey)) {
      this.displayedColumns = this.displayedColumns.filter(item => item !== columnKey);
    } else {
      const visibleColumnSet = new Set([...this.displayedColumns, columnKey]);
      this.displayedColumns = this.allColumnPreferences
        .filter(item => visibleColumnSet.has(item.key))
        .map(item => item.key);
    }

    this.persistColumnPreferences();
  }

  resetColumnPreferences(): void {
    this.displayedColumns = this.allColumnPreferences.map(item => item.key);
    this.persistColumnPreferences();
