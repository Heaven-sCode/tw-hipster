import { Component, Input, OnInit } from '@angular/core';
import { ActivatedRoute, Router } from '@angular/router';
import { CommonModule, DatePipe } from '@angular/common';
import { MatButtonModule } from '@angular/material/button';
import { MatIconModule } from '@angular/material/icon';
import { I<%= entity.name %> } from '../<%= toKebabCase(entity.name) %>.model';
import { <%= entity.name %>Service } from '../service/<%= toKebabCase(entity.name) %>.service';

@Component({
  selector: 'app-<%= toKebabCase(entity.name) %>-card',
  templateUrl: './<%= toKebabCase(entity.name) %>-card.component.html',
  styleUrls: ['./<%= toKebabCase(entity.name) %>-card.component.css'],
  standalone: true,
  imports: [CommonModule, DatePipe, MatButtonModule, MatIconModule]
})
export class <%= entity.name %>CardComponent implements OnInit {
  @Input() item?: I<%= entity.name %>;
  @Input() searchTerm: string = '';
  @Input() searchBy: string = '';
  @Input() pinned = false;
  @Input() flagClass = 'text-neutral-300';

  constructor(
    private route: ActivatedRoute,
    private router: Router,
    private service: <%= entity.name %>Service
  ) {}

  ngOnInit(): void {
    if (!this.item) {
      const id = this.route.snapshot.paramMap.get('id');
      if (id) {
        this.service.find(Number(id)).subscribe({
          next: (res) => {
            if (res.body) {
              this.item = res.body;
            }
          }
        });
      }
    }
  }

  openFormDrawer(mode: string): void {
    if (this.item && this.item.id) {
      const url = this.router.url;
      if (url.endsWith('/card') || url.includes('/' + this.item.id + '/card')) {
        this.router.navigate(['../edit'], { relativeTo: this.route });
      } else {
        this.router.navigate([this.item.id, 'edit'], { relativeTo: this.route });
      }
    }
  }

  highlightText(text: any, query: string): string {
    if (!query || text === null || text === undefined) return text ? String(text) : '';
    const textStr = String(text);
    const regex = new RegExp(`(${this.escapeRegExp(query)})`, 'gi');
    return textStr.replace(regex, '<span class="bg-yellow-100 font-semibold text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400">$1</span>');
  }

  private escapeRegExp(string: string): string {
    return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }
}
