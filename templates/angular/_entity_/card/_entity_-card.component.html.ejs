<div class="card {{item?.id}}-card">
  <h3 class="card-title">{{item?.id}}</h3>
  <p class="card-body">
    <!-- Add the fields you want to show on the card -->
    <% entity.fields.forEach(function (field) { %>
      <strong><%= toPascalCase(field.fieldName) %>:</strong> 
      <% if (['LocalDate', 'Instant', 'ZonedDateTime'].includes(field.fieldType)) { %>
        {{item?.<%= field.fieldName %>?.toDate() | date}}<br/>
      <% } else { %>
        <span [innerHTML]="highlightText(item?.<%= field.fieldName %>, searchBy === '<%= field.fieldName %>' ? searchTerm : '')"></span><br/>
      <% } %>
    <% }) %>
  </p>
  <button mat-button color="primary" (click)="openFormDrawer('edit')">
    Edit
  </button>
</div>
